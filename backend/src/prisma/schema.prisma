// ─────────────────────────────────────────────────────────────
// DevConnect — Prisma Schema
// Backend: NestJS 11 · Prisma 7 · PostgreSQL (Supabase)
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────

enum UserRole {
  DEVELOPER
  RECRUITER
  ADMIN
  MODERATOR
}

enum AvailabilityStatus {
  OPEN_TO_WORK
  HIRING
  OPEN_TO_COLLAB
  NOT_AVAILABLE
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum SwipeAction {
  LIKE
  SUPER_LIKE
  PASS
}

enum MatchStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ProjectMemberRole {
  OWNER
  CONTRIBUTOR
  VIEWER
}

enum ProjectStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum NotificationType {
  MATCH
  MESSAGE
  INVITATION
  PROJECT
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

// ─── Auth & Identity ────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?   @map("password_hash")
  emailVerified     Boolean   @default(false) @map("email_verified")
  emailVerificationToken String? @map("email_verification_token")
  mfaSecret         String?   @map("mfa_secret")
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  role              UserRole  @default(DEVELOPER)
  planTier          PlanTier  @default(FREE) @map("plan_tier")
  isSuspended       Boolean   @default(false) @map("is_suspended")
  isBanned          Boolean   @default(false) @map("is_banned")
  lastLoginAt       DateTime? @map("last_login_at")
  deletedAt         DateTime? @map("deleted_at")
  scheduledDeleteAt DateTime? @map("scheduled_delete_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  profile           Profile?
  oauthAccounts     OAuthAccount[]
  sessions          Session[]
  apiKeys           ApiKey[]
  passwordResetTokens PasswordResetToken[]
  notificationPreferences NotificationPreference[]

  sentInvitations     Invitation[]     @relation("InvitationSender")
  receivedInvitations Invitation[]     @relation("InvitationReceiver")

  swipesGiven       Swipe[]          @relation("SwipeSource")
  swipesReceived    Swipe[]          @relation("SwipeTarget")

  matchesAsUserOne  Match[]          @relation("MatchUserOne")
  matchesAsUserTwo  Match[]          @relation("MatchUserTwo")

  messagesSent      Message[]        @relation("MessageSender")
  conversations     ConversationMember[]

  projectsOwned     Project[]        @relation("ProjectOwner")
  projectMemberships ProjectMember[]

  notifications     Notification[]
  devices           UserDevice[]
  auditLogs         AuditLog[]
  reports           Report[]         @relation("ReportedBy")
  moderationActions ModerationAction[]

  collabParticipants CollabRoomParticipant[]

  connectionsAsA    Connection[]     @relation("ConnectionUserA")
  connectionsAsB    Connection[]     @relation("ConnectionUserB")

  blockedUsers      BlockedUser[]    @relation("BlockerUser")
  blockedByUsers    BlockedUser[]    @relation("BlockedUserRel")

  swipeLimits       SwipeLimit[]
  fraudFlag         FraudFlag?

  savedProfiles     SavedProfile[]  @relation("SavedByUser")
  savedByUsers      SavedProfile[]  @relation("SavedUser")

  reviewsGiven      Review[]        @relation("Reviewer")
  reviewsReceived   Review[]        @relation("ReviewTarget")
  contributions     Contribution[]

  collabPairsAsA    CollaborationPair[] @relation("CollabUserA")
  collabPairsAsB    CollaborationPair[] @relation("CollabUserB")

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model NotificationPreference {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  channel   NotificationChannel @default(IN_APP)
  type      NotificationType
  enabled   Boolean @default(true)

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, type])
  @@map("notification_preferences")
}

model UserDevice {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  deviceToken    String    @map("device_token")
  platform       String    // ios | android | web
  deviceName     String?   @map("device_name")
  userAgent      String?   @map("user_agent")
  isActive       Boolean   @default(true) @map("is_active")
  lastActiveAt   DateTime? @map("last_active_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceToken, platform])
  @@index([userId])
  @@index([deviceToken])
  @@map("user_devices")
}

model OAuthAccount {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  provider    String   // github | google
  providerId  String   @map("provider_id")
  accessToken String?  @map("access_token")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ApiKey {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  keyHash     String   @unique @map("key_hash")
  lastUsedAt  DateTime? @map("last_used_at")
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

// ─── Profile & Skills ───────────────────────────────────────

model Profile {
  id                String              @id @default(uuid())
  userId            String              @unique @map("user_id")
  displayName       String              @map("display_name")
  headline          String?
  bio               String?
  avatarUrl         String?             @map("avatar_url")
  location          String?
  experienceLevel   String?             @map("experience_level")
  githubUsername    String?             @map("github_username")
  githubData        Json?               @map("github_data")
  portfolioLinks    Json?               @map("portfolio_links")
  preferences       Json?               @map("preferences")
  availability      AvailabilityStatus  @default(NOT_AVAILABLE)
  reputationScore   Int                 @default(0) @map("reputation_score")
  profileCompleteness Int               @default(0) @map("profile_completeness")
  isPublic          Boolean             @default(true) @map("is_public")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            ProfileSkill[]
  endorsements      Endorsement[]       @relation("EndorsedProfile")

  @@index([userId, isPublic])
  @@index([reputationScore])
  @@map("profiles")
}

model Skill {
  id        String         @id @default(uuid())
  name      String         @unique
  category  String?
  createdAt DateTime       @default(now()) @map("created_at")

  profiles  ProfileSkill[]

  @@map("skills")
}

model ProfileSkill {
  id             String   @id @default(uuid())
  profileId      String   @map("profile_id")
  skillId        String   @map("skill_id")
  proficiency    Int      @default(1) // 1-5
  isVerified     Boolean  @default(false) @map("is_verified")

  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill          Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@map("profile_skills")
}

model Endorsement {
  id           String   @id @default(uuid())
  profileId    String   @map("profile_id")
  endorserId   String   @map("endorser_id")
  skill        String?  @map("skill")
  message      String?
  createdAt    DateTime @default(now()) @map("created_at")

  profile      Profile  @relation("EndorsedProfile", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, endorserId])
  @@map("endorsements")
}

// ─── Discovery / Swipe / Matching ───────────────────────────

model Swipe {
  id          String      @id @default(uuid())
  sourceId    String      @map("source_id")
  targetId    String      @map("target_id")
  action      SwipeAction
  createdAt   DateTime    @default(now()) @map("created_at")

  source      User        @relation("SwipeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target      User        @relation("SwipeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
  @@map("swipes")
}

model Match {
  id           String      @id @default(uuid())
  userOneId    String      @map("user_one_id")
  userTwoId    String      @map("user_two_id")
  status       MatchStatus @default(ACTIVE)
  matchScore   Float?      @map("match_score")
  createdAt    DateTime    @default(now()) @map("created_at")

  userOne      User        @relation("MatchUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo      User        @relation("MatchUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([userOneId, userTwoId])
  @@index([status])
  @@map("matches")
}

model Connection {
  id         String   @id @default(uuid())
  userAId    String   @map("user_a_id")
  userBId    String   @map("user_b_id")
  tag        String?  // team | collaborator | recruiter
  createdAt  DateTime @default(now()) @map("created_at")

  userA      User     @relation("ConnectionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB      User     @relation("ConnectionUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@map("connections")
}

model Invitation {
  id          String            @id @default(uuid())
  senderId    String            @map("sender_id")
  receiverId  String            @map("receiver_id")
  projectId   String?           @map("project_id")
  message     String?
  status      InvitationStatus  @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at")
  respondedAt DateTime?         @map("responded_at")

  sender      User              @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User              @relation("InvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([senderId, status])
  @@index([receiverId, status])
  @@map("invitations")
}

model BlockedUser {
  id         String   @id @default(uuid())
  blockerId  String   @map("blocker_id")
  blockedId  String   @map("blocked_id")
  createdAt  DateTime @default(now()) @map("created_at")

  blocker    User     @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("BlockedUserRel", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@index([blockedId, blockerId])
  @@map("blocked_users")
}

// ─── Messaging ──────────────────────────────────────────────

model Conversation {
  id          String    @id @default(uuid())
  name        String?   @map("name")
  matchId     String?   @unique @map("match_id")
  projectId   String?   @map("project_id")
  isGroup     Boolean   @default(false) @map("is_group")
  createdAt   DateTime  @default(now()) @map("created_at")

  match       Match?    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members     ConversationMember[]
  messages    Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  lastReadAt     DateTime?    @map("last_read_at")
  isMuted        Boolean      @default(false) @map("is_muted")
  joinedAt       DateTime     @default(now()) @map("joined_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  content        String?
  attachments    Json?        // [{url, type, name}]
  status         String       @default("SENT") // SENT | DELIVERED | READ
  deliveredAt    DateTime?    @map("delivered_at")
  editedAt       DateTime?    @map("edited_at")
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reactions      MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId, status])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

// ─── Projects & Collaboration ───────────────────────────────

model Project {
  id             String            @id @default(uuid())
  ownerId        String            @map("owner_id")
  title          String
  description    String?
  requiredSkills Json?             @map("required_skills")
  budget         String?
  timeline       String?
  status         ProjectStatus     @default(DRAFT)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  owner          User              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  tasks          Task[]
  milestones     Milestone[]
  invitations    Invitation[]
  conversations  Conversation[]
  files          SharedFile[]
  contributions  Contribution[]

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

model Milestone {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  status      String   @default("pending") // pending | in_progress | completed
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestones")
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String            @map("project_id")
  userId    String            @map("user_id")
  role      ProjectMemberRole @default(CONTRIBUTOR)
  joinedAt  DateTime          @default(now()) @map("joined_at")

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@map("project_members")
}

model Task {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  title       String
  description String?
  status      String    @default("todo")
  assigneeId  String?   @map("assignee_id")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

model SharedFile {
  id         String   @id @default(uuid())
  projectId  String?  @map("project_id")
  uploaderId String   @map("uploader_id")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileType   String?  @map("file_type")
  sizeBytes  Int?     @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("shared_files")
}

// ─── Collaboration Rooms ────────────────────────────────────

model CollabRoom {
  id        String   @id @default(uuid())
  name      String?
  projectId String?  @map("project_id")
  matchId   String?  @map("match_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  endedAt   DateTime? @map("ended_at")

  participants CollabRoomParticipant[]
  recordings   CollabRoomRecording[]

  @@index([projectId])
  @@index([matchId])
  @@map("collab_rooms")
}

model CollabRoomParticipant {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  room      CollabRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, leftAt])
  @@map("collab_room_participants")
}

model CollabRoomRecording {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  url       String
  duration  Int?
  createdAt DateTime @default(now()) @map("created_at")

  room      CollabRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("collab_room_recordings")
}

// ─── Swipe Limits (Feature Gating) ──────────────────────────

model SwipeLimit {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  date       DateTime @map("date") // normalized to start of day
  swipeCount Int      @default(0) @map("swipe_count")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("swipe_limits")
}

// ─── Fraud Detection ─────────────────────────────────────────

model FraudFlag {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  riskScore Int      @default(0) @map("risk_score")
  signals   Json?    // { rapidSwiping: bool, highRequestRate: bool, lowProfileCompletion: bool, duplicateIp: bool, duplicateDevice: bool }
  flags     Json?    // ["flagged_for_review", "temp_restricted", "captcha_triggered", "soft_banned", "hard_banned"]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@index([riskScore])
  @@index([isActive])
  @@map("fraud_flags")
}

// ─── Notifications ──────────────────────────────────────────

model Notification {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String?
  metadata  Json?
  isRead    Boolean             @default(false) @map("is_read")
  createdAt DateTime            @default(now()) @map("created_at")

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Saved Profiles / Bookmarks ─────────────────────────────

model SavedProfile {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  savedUserId String  @map("saved_user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation("SavedByUser", fields: [userId], references: [id], onDelete: Cascade)
  savedUser  User     @relation("SavedUser", fields: [savedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, savedUserId])
  @@index([userId])
  @@index([savedUserId])
  @@map("saved_profiles")
}

// ─── Reviews & Reputation ────────────────────────────────────

model Review {
  id          String   @id @default(uuid())
  reviewerId  String   @map("reviewer_id")
  targetId    String   @map("target_id")
  projectId   String?  @map("project_id")
  rating      Int      // 1-5
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  reviewer    User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  target      User     @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, targetId, projectId])
  @@index([targetId])
  @@map("reviews")
}

model Contribution {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  projectId   String   @map("project_id")
  description String?
  linesOfCode Int      @default(0) @map("lines_of_code")
  commits     Int      @default(0)
  tasksDone   Int      @default(0) @map("tasks_done")
  impactScore Float    @default(0) @map("impact_score")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@map("contributions")
}

model CollaborationPair {
  id              String   @id @default(uuid())
  userAId         String   @map("user_a_id")
  userBId         String   @map("user_b_id")
  projectsCount   Int      @default(0) @map("projects_count")
  averageScore    Float    @default(0) @map("average_score")
  lastCollaborated DateTime? @map("last_collaborated")
  compatibilityTags Json?  @map("compatibility_tags")
  createdAt       DateTime @default(now()) @map("created_at")

  userA           User     @relation("CollabUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB           User     @relation("CollabUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("collaboration_pairs")
}

// ─── Moderation / Admin / Audit ─────────────────────────────

model Report {
  id           String   @id @default(uuid())
  reporterId   String   @map("reporter_id")
  targetType   String   @map("target_type")
  targetId     String   @map("target_id")
  reason       String
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")

  reporter     User     @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("reports")
}

model ModerationAction {
  id           String   @id @default(uuid())
  moderatorId  String   @map("moderator_id")
  targetType   String   @map("target_type")
  targetId     String   @map("target_id")
  action       String
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  moderator    User     @relation(fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@map("moderation_actions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
