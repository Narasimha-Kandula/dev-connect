# ─── App ─────────────────────────────────────────────────────────
# Deployment environment: development | production
NODE_ENV=development
# Backend listen port (Railway sets PORT automatically)
PORT=4000
# Comma-separated allowed origins for CORS (no wildcard with credentials: true)
CORS_ORIGIN=http://localhost:3000
# Public-facing frontend URL (used in email links, redirects)
FRONTEND_URL=http://localhost:3000

# ─── Database (Supabase PostgreSQL via pgBouncer pooler) ────────
# Pooled connection URL — used by Prisma at runtime.
# Rotate DB password in Supabase Dashboard → Project Settings → Database.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (non-pooled) URL — used by Prisma migrations.
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── Redis (Upstash or local) ────────────────────────────────────
# rediss:// for TLS, redis:// for plain TCP
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_UPSTASH_ENDPOINT.upstash.io:6379
REDIS_HOST=YOUR_UPSTASH_ENDPOINT.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# ─── JWT ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Firebase Cloud Messaging (FCM) ──────────────────────────────
# Service account JSON (minified single line) from Firebase Console → Project Settings → Service accounts
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── APNs (Apple Push Notification service) ──────────────────────
# APNs authentication key (.p8 file content as single line) from Apple Developer → Certificates → Keys
APNS_KEY=-----BEGIN PRIVATE KEY-----\n...
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_BUNDLE_ID=com.devconnect.app

# ─── Fraud Detection ─────────────────────────────────────────────
FRAUD_SWIPE_THRESHOLD=50
FRAUD_REQUEST_THRESHOLD=200
FRAUD_MIN_PROFILE_COMPLETENESS=20
# reCAPTCHA v3 (optional). Get keys from https://www.google.com/recaptcha/admin
CAPTCHA_SITE_KEY=your-captcha-site-key
CAPTCHA_SECRET_KEY=your-captcha-secret-key

# ─── Swipe Limits (Feature Gating) ─────────────────────────────
SWIPE_LIMIT_FREE=20
SWIPE_LIMIT_PRO=100

# ─── Meilisearch (Cloud or self-hosted) ──────────────────────────
# Master key from Meilisearch Cloud dashboard
MEILISEARCH_HOST=https://ms-YOUR_UID.sgp.meilisearch.io
MEILISEARCH_API_KEY=your-meilisearch-master-key

# ─── Resend (Transactional Email) ────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM=DevConnect <noreply@YOUR_DOMAIN.dev>

# ─── OAuth ───────────────────────────────────────────────────────
# GitHub: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Comma-separated if multiple frontend URLs
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─── Feature Flags ───────────────────────────────────────────────
ENABLE_AI_MATCHING=false
ENABLE_REALTIME=true

# ─── Seed Script (optional) ─────────────────────────────────────
# If set, the seed script uses this as the admin password instead of generating a random one
# ADMIN_PASSWORD=your-admin-password
